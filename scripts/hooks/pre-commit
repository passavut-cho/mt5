#!/bin/sh
# SmartEA pre-commit guard — ADR 0003 M4 • ใช้กับทุก agent และคน (Claude, Codex, Owner)
# เปิดใช้: git config core.hooksPath scripts/hooks

# 1) ไฟล์ risk (กฎเหล็กข้อ 6) — commit ได้เฉพาะเมื่อ Owner อนุมัติด้วย SMARTEA_RISK_EDIT=1 ใน command นั้น
protected='^src/Include/Core/RiskManager\.mqh$|^src/Include/Config/'
if git diff --cached --name-only | grep -Eq "$protected"; then
  if [ "$SMARTEA_RISK_EDIT" != "1" ]; then
    echo "⛔ BLOCKED (ADR 0003 M4): commit นี้แตะไฟล์ risk:"
    git diff --cached --name-only | grep -E "$protected" | sed 's/^/   - /'
    echo "   ต้องให้ Owner อนุมัติ แล้ว commit ด้วย: SMARTEA_RISK_EDIT=1 git commit ..."
    exit 1
  fi
fi

# 2) worktree ของ Codex ห้าม commit ลง main
top=$(git rev-parse --show-toplevel 2>/dev/null)
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
case "$top" in
  *MT5-codex*)
    if [ "$branch" = "main" ]; then
      echo "⛔ BLOCKED (ADR 0003 M2): worktree ของ Codex ห้าม commit ลง main — ใช้ branch codex/T-NNN แล้วเปิด PR"
      exit 1
    fi ;;
esac
exit 0
